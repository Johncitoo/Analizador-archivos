server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Los archivos de /assets llevan un hash en el nombre: se pueden guardar en caché
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
